{
  "//": "The hooks module. The engine lays .claude-plugin/types when it loads this folder (--plugin-dir, or the mods folder); run `tsc -p .` after that.",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [".claude-plugin/types", "hooks"]
}
